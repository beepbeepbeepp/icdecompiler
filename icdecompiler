# ICDeCompiler: lower MLIR (TOSA or linalg) to C.
# Default target offloads matmul to the systolic array; --cpu keeps everything on CPU.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Works both in a built source tree and in a binary package where the tools
# sit next to this script.
if [[ -x "$HERE/build/bin/icdec-opt" ]]; then
  BIN="$HERE/build/bin"
else
  BIN="$HERE"
fi
OPT="$BIN/icdec-opt"
TRANSLATE="$BIN/icdec-translate"

usage() {
  cat <<'EOF'
usage: icdecompiler <input.mlir> [-o output.c] [--cpu]

Lower a TOSA (or linalg) MLIR file to C.

  -o FILE   write the C code to FILE instead of stdout
  --cpu     keep everything on the CPU (default: matmul goes to the
            systolic array through systolic_multiply_large)
  -h, --help  show this help
EOF
}

if [[ $# -lt 1 ]]; then
  usage >&2
  exit 1
fi
case "$1" in
  -h|--help) usage; exit 0 ;;
esac

INPUT="$1"; shift
OUTPUT=""
PASS="--icdec-compile"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -o)    OUTPUT="$2"; shift 2 ;;
    --cpu) PASS="--icdec-compile-cpu"; shift ;;
    *)     echo "unknown option: $1" >&2; exit 1 ;;
  esac
done

if [[ -n "$OUTPUT" ]]; then
  "$OPT" "$INPUT" "$PASS" | "$TRANSLATE" --mlir-to-cpp > "$OUTPUT"
  echo "wrote $OUTPUT"
else
  "$OPT" "$INPUT" "$PASS" | "$TRANSLATE" --mlir-to-cpp
fi